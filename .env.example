# CampusClaw 环境配置模板
#
# 用法：复制为同目录下的 .env，填入下列每个变量的真实值。
# .env 已被 .gitignore 与 .dockerignore 排除；仓库与镜像中不得出现任何真实值。
# 本文件的所有赋值均为空，示例值只写在注释里。

# --- MySQL 连接 ---
# api 容器通过服务名 db 访问数据库，不映射宿主机端口。
# 示例：db / 3306 / campusclaw / campusclaw
MYSQL_HOST=
MYSQL_PORT=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
# 仅 db 容器初始化使用，API 不读取。
MYSQL_ROOT_PASSWORD=

# --- 种子账号密码 ---
# 必填，1..72 UTF-8 字节。缺失、为空或超长时 API 启动失败，不会落入默认密码。
SEED_TEACHER_A_PASSWORD=
SEED_STUDENT_A1_PASSWORD=
SEED_TEACHER_B_PASSWORD=
SEED_STUDENT_B1_PASSWORD=

# --- 向量库 ---
# api 容器通过服务名 qdrant 访问，不映射宿主机端口；留空时使用 http://qdrant:6333。
QDRANT_URL=
# 更换嵌入模型时可使用新集合，填充新向量后再切换；旧集合留作回退。
QDRANT_COLLECTION=

# --- 服务端模型网关 ---
# 嵌入网关需兼容 POST {BASE_URL}/embeddings，对话网关需兼容 POST {BASE_URL}/chat/completions。
# 这两组变量只被 API 读取，不会出现在前端构建产物、浏览器响应或日志中。
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
# 必须等于嵌入模型实际返回的向量维度；不一致时 API 启动失败，而不是混写不同维度的向量。
EMBEDDING_DIMENSIONS=
EMBEDDING_API_KEY=
CHAT_BASE_URL=
CHAT_MODEL=
CHAT_API_KEY=

# --- 浏览器入口 ---
# POST 请求同源校验的比对基准，必须是完整来源（scheme://host[:port]，无路径）。
# 示例：http://localhost:8080
PUBLIC_ORIGIN=
# Optional; only for local Vite at http://localhost:5173 with PUBLIC_ORIGIN=http://localhost:8080.
DEV_PUBLIC_ORIGIN=

# 登录鉴权只用 Authorization: Bearer 请求头，不使用任何 Cookie。
# 生产环境必须通过 HTTPS 提供入口，否则 token 会以明文在网络中传输。
